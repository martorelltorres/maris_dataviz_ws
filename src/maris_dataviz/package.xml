<?xml version="1.0"?>
<package format="2">
  <name>maris_dataviz</name>
  <version>0.1.0</version>
  <description>Replay and 3D visualization in RViz of raw AUV bagfiles: navigation, mission plan, seafloor-projected camera images, side-scan sonar and multibeam bathymetry.</description>
  <maintainer email="antonimartorelltorres@gmail.com">Antoni Martorell</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>genpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
</package>
