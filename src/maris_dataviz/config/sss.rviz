Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.4323529303073883
    Tree Height: 802
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: SSS waterfall
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.30000001192092896
      Cell Size: 10
      Class: rviz/Grid
      Color: 120; 160; 200
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid (10 m)
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: world
      Value: false
    - Class: rviz/TF
      Enabled: false
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Alpha: 1
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: false
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /maris_dataviz/nav/vehicle
          Name: Vehicle
          Namespaces:
            altitude: true
            telemetry: true
            vehicle: true
          Queue Size: 10
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 220; 40
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Billboards
          Line Width: 0.30000001192092896
          Name: Trail
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /maris_dataviz/nav/trail
          Unreliable: false
          Value: true
      Enabled: true
      Name: Navigation
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /maris_dataviz/mission/markers
          Name: Mission plan
          Namespaces:
            drop_lines: true
            labels: true
            sea_surface: true
            tolerance: true
            waypoints: true
          Queue Size: 100
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /maris_dataviz/mission/legs
          Name: Mission legs
          Namespaces:
            direction: true
            legs: true
            legs_surface: true
          Queue Size: 100
          Value: true
        - Alpha: 0.800000011920929
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 255; 255
          Enabled: false
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.029999999329447746
          Name: Captain trajectory
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /sparus2/captain/trajectory_path
          Unreliable: false
          Value: false
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /sparus2/pilot/waypoint_marker
          Name: Current goal
          Namespaces:
            /sparus2/pilot: true
          Queue Size: 10
          Value: true
      Enabled: true
      Name: Mission
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /maris_dataviz/satellite/layer
      Name: Satellite
      Namespaces:
        satellite: true
      Queue Size: 10
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /maris_dataviz/sss/mosaic
          Name: SSS mosaic
          Namespaces:
            sss_mosaic: true
          Queue Size: 200
          Value: true
      Enabled: true
      Name: Side-scan sonar
    - Class: rviz/Image
      Enabled: true
      Image Topic: /maris_dataviz/sss/waterfall
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: SSS waterfall
      Normalize Range: false
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 8; 22; 38
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
