        Y: 8.778594970703125
        Z: -17.829343795776367
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.125
      Target Frame: sparus2/base_link
      Yaw: 4.185003280639648
    Saved:
